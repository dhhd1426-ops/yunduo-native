+// 云朵天气移植：NDK 的 libc++ 还没有 std::atomic<std::shared_ptr<T>>（C++20 P0718），换成带锁的同名接口（只用到 load / store）
+template<typename T>
+class AtomicSharedPtr {
+public:
+    AtomicSharedPtr() = default;
+    AtomicSharedPtr(std::nullptr_t) {}
+    std::shared_ptr<T> load() const { std::lock_guard<std::mutex> lk(m_mu); return m_p; }
+    void store(std::shared_ptr<T> p) { std::lock_guard<std::mutex> lk(m_mu); m_p = std::move(p); }
+private:
+    mutable std::mutex m_mu;
+    std::shared_ptr<T> m_p;
+};
